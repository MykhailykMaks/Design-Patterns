<UserControl x:Class="Arena.Wpf.Views.TeamView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="*" /><RowDefinition Height="210" /><RowDefinition Height="90" /></Grid.RowDefinitions>
  <DockPanel><Button Content="До меню" DockPanel.Dock="Right" Command="{Binding MenuCommand}" VerticalAlignment="Top" /><StackPanel><TextBlock Text="Вибір команди" Style="{StaticResource Heading}" /><TextBlock Text="Оберіть трьох із п’яти та призначте лідера з аурою" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,15,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ItemsControl ItemsSource="{Binding Heroes}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Margin="0,0,12,9" Padding="12,9" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.InspectHeroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
       <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></DataTrigger>
       <DataTrigger Binding="{Binding IsInspected}" Value="True"><Setter Property="Background" Value="#414B43" /><Setter Property="BorderBrush" Value="{StaticResource Gold}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Border Width="55" Height="55" Background="{Binding Portrait}" HorizontalAlignment="Left" />
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="19" /><TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
       <TextBlock Grid.Column="2" Text="✓" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" />
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border Grid.Column="1" Background="#1D2931" BorderBrush="#46535B" BorderThickness="1" CornerRadius="4" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid DataContext="{Binding SelectedHero}"><Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="224" Height="224" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{Binding Portrait}" />
      <StackPanel Grid.Column="1">
       <TextBlock Text="{Binding Name}" FontSize="31" FontWeight="SemiBold" />
       <TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" Margin="0,5,0,15" />
       <TextBlock Text="{Binding Stats}" FontSize="16" Margin="0,0,0,16" ToolTip="Критичне влучання подвоює шкоду удару." />
       <TextBlock Text="{Binding BasicName}" Foreground="{StaticResource Accent}" FontSize="17" /><TextBlock Text="{Binding BasicDescription}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,13" />
       <TextBlock Text="{Binding SpecialName}" Foreground="{StaticResource Accent}" FontSize="17" /><TextBlock Text="{Binding SpecialDescription}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,13" />
       <TextBlock Text="{Binding Aura}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" FontSize="14" />
      </StackPanel>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="{Binding ToggleHeroLabel}" Command="{Binding ToggleHeroCommand}" Style="{StaticResource PrimaryButton}" /><TextBlock Text="{Binding SelectedHero.CooldownDescription}" Style="{StaticResource Caption}" VerticalAlignment="Center" /></DockPanel>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2">
   <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding TeamAura}" Foreground="{StaticResource Gold}" DockPanel.Dock="Right" FontSize="13" /><TextBlock Text="{Binding TeamCount}" Foreground="{StaticResource Muted}" FontSize="13" /></DockPanel>
   <Border Background="#18232A" BorderBrush="#3C4C56" BorderThickness="1" Height="144" Padding="12">
    <ItemsControl ItemsSource="{Binding Team}" ItemsPanel="{StaticResource HorizontalTeam}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Margin="5,0" Padding="10,6" CornerRadius="6" Background="#1E2C34">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#42555D" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers>
        <DataTrigger Binding="{Binding IsLeader}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}" /><Setter Property="BorderThickness" Value="2" />
         <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.35" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        </DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <Border Background="{Binding Portrait}" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Left" />
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="20" /><TextBlock Text="{Binding Role}" Style="{StaticResource Caption}" Margin="0,5,0,9" />
        <Button Content="{Binding LeaderButtonText}" FontSize="12" Padding="10,7" Command="{Binding DataContext.SetLeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding HasAura, Converter={StaticResource BoolVisibility}}" />
       </StackPanel>
      </Grid></Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Border>
  </StackPanel>
  <DockPanel Grid.Row="3" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Почати бій" Command="{Binding BeginBattleCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Padding="32,14" /><StackPanel><TextBlock Text="{Binding TeamHint}" FontSize="17" /><TextBlock Text="{Binding EncounterSummary}" Style="{StaticResource Caption}" Margin="0,9,0,0" /></StackPanel></DockPanel>
 </Grid>
</UserControl>
