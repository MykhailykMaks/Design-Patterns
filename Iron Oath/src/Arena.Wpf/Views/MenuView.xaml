<UserControl x:Class="Arena.Wpf.Views.MenuView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <StackPanel Width="660" VerticalAlignment="Center" HorizontalAlignment="Center">
   <TextBlock Text="THREE SHALL STAND. ONE FLAME ENDURES." Foreground="{StaticResource Gold}" FontSize="13" HorizontalAlignment="Center" />
   <TextBlock Text="Iron Oath" FontFamily="Georgia" FontSize="70" HorizontalAlignment="Center" Margin="0,16,0,16" />
   <Rectangle Height="1" Width="160" Fill="{StaticResource Gold}" Margin="0,0,0,22" />
   <TextBlock Text="Зберіть команду. Читайте наміри ворога.&#xA;Оберіть мить для вирішальної навички." FontSize="19" Foreground="{StaticResource Muted}" TextAlignment="Center" LineHeight="30" Margin="0,0,0,32" />
   <StackPanel Width="360">
    <Button Content="Почати" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6" />
    <Button Content="Налаштування" Command="{Binding SettingsCommand}" Margin="0,6" />
    <Button Content="Вийти з гри" Command="{Binding ExitCommand}" Margin="0,6" />
   </StackPanel>
   <TextBlock Text="{Binding EncounterSummary}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,28,0,0" />
  </StackPanel>
  <TextBlock Text="ПОКРОКОВА АРЕНА 3 × 3" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
 </Grid>
</UserControl>
