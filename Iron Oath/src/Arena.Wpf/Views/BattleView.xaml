<UserControl x:Class="Arena.Wpf.Views.BattleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="218" /><RowDefinition Height="96" /><RowDefinition Height="224" /><RowDefinition Height="106" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <DockPanel Margin="6,0">
   <Button Content="До меню" DockPanel.Dock="Right" Command="{Binding MenuCommand}" VerticalAlignment="Top" Padding="18,9" />
   <Button Content="{Binding PlaybackSpeedText}" DockPanel.Dock="Right" Command="{Binding CyclePlaybackSpeedCommand}" VerticalAlignment="Top" MinWidth="115" Padding="14,9" Margin="0,0,8,0" ToolTip="Змінити темп бою: звичайний, подвійний або миттєвий. Доступно також під час дії." />
   <StackPanel><TextBlock Text="IRON OATH" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="СУПРОТИВНИКИ · НАМІРИ НА РАУНД" Style="{StaticResource Caption}" Margin="0,3,0,0" /></StackPanel>
  </DockPanel>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding Enemies}" ItemsPanel="{StaticResource HorizontalTeam}" ItemTemplate="{StaticResource CombatCard}" />
  <Grid Grid.Row="2" Margin="0,21,0,-1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="780" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Rectangle Height="1" Fill="#52605E" Margin="10,0,22,0" />
   <Border Grid.Column="1" Background="#202D34" BorderBrush="#516260" BorderThickness="1" CornerRadius="3" Padding="22,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="140" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="РАУНД" Style="{StaticResource Caption}" /><TextBlock Text="{Binding RoundText}" FontSize="28" Margin="0,3,0,0" /></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding PhaseText}" Foreground="{StaticResource Accent}" FontSize="23" /><TextBlock Text="{Binding ActionHint}" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
     <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="СКЛАДНІСТЬ" Style="{StaticResource Caption}" /><TextBlock Text="{Binding BattleDifficulty}" FontSize="20" Margin="0,8,0,0" /></StackPanel>
    </Grid>
   </Border>
   <Rectangle Grid.Column="2" Height="1" Fill="#52605E" Margin="22,0,10,0" />
  </Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <DockPanel Margin="8,0"><TextBlock Text="{Binding TeamAura}" Foreground="{StaticResource Gold}" FontSize="12" DockPanel.Dock="Right" /><TextBlock Text="ВАША КОМАНДА" Style="{StaticResource Caption}" /></DockPanel>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding Players}" ItemsPanel="{StaticResource HorizontalTeam}" ItemTemplate="{StaticResource CombatCard}" />
  </Grid>
  <Border Grid.Row="4" Margin="8,12,8,0" BorderBrush="#46535B" BorderThickness="0,1,0,0" Padding="0,12,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding ActorName}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding SpecialAvailability}" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Content="{Binding BasicName}" Command="{Binding BasicCommand}" ToolTip="{Binding BasicTooltip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,10,0" Padding="22,11">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsBasicSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}" /><Setter Property="Background" Value="#47534A" /><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From=".55" To="1" Duration="0:0:0.22" FillBehavior="Stop" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="{Binding SpecialName}" Command="{Binding SpecialCommand}" ToolTip="{Binding SpecialTooltip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,10,0" Padding="22,11">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSpecialSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}" /><Setter Property="Background" Value="#47534A" /><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From=".55" To="1" Duration="0:0:0.22" FillBehavior="Stop" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="Застосувати" Command="{Binding ConfirmAllCommand}" Visibility="{Binding CanConfirmAll, Converter={StaticResource BoolVisibility}}" Style="{StaticResource PrimaryButton}" Padding="18,11" />
     </StackPanel>
     <Button Grid.Column="2" Content="Повернути раунд" Command="{Binding RestoreCommand}" Padding="18,11" ToolTip="Відновити здоров’я, дії, ефекти та наміри на початок поточного раунду." />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding SkillDescription}" Style="{StaticResource Caption}" Margin="200,8,0,0" TextWrapping="Wrap" />
   </Grid>
  </Border>
  <Border Grid.Row="5" Margin="8,6,8,0" Background="#121D24" BorderBrush="#37464E" BorderThickness="1" Padding="12,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock Text="ЖУРНАЛ БОЮ" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
     <ItemsControl ItemsSource="{Binding BattleLog}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#293941" BorderThickness="0,0,0,1" Padding="3,2">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="23" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Round, StringFormat='Р. {0:00}'}" FontSize="13" Foreground="#A4AFB5" />
        <TextBlock Grid.Column="1" Text="{Binding Symbol}" Foreground="{Binding Color}" FontSize="14" FontWeight="Bold" />
        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{Binding Color}" FontSize="13" />
        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" />
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</UserControl>
