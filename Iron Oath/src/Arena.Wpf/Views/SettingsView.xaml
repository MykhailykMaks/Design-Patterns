<UserControl x:Class="Arena.Wpf.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Width="850" VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="Налаштування" Style="{StaticResource Heading}" Margin="0,0,0,10" />
  <TextBlock Text="Складність" Foreground="{StaticResource Gold}" FontSize="18" Margin="0,0,0,22" />
  <ItemsControl ItemsSource="{Binding Difficulties}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Margin="0,0,0,14" HorizontalContentAlignment="Stretch" ToolTip="{Binding Hint}" Padding="24,22" Command="{Binding DataContext.ChooseDifficultyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Name}" FontSize="24" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Multipliers}" Foreground="{StaticResource Accent}" FontSize="17" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0" /></StackPanel>
     </Grid>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding SettingsNote}" TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource Muted}" Margin="0,12,0,24" />
  <StackPanel Orientation="Horizontal">
   <Button Content="Зберегти" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
   <Button Content="До меню" Command="{Binding MenuCommand}" />
   <TextBlock Text="✓ Налаштування збережено" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
              Margin="20,0,0,0" Visibility="{Binding SettingsSaved, Converter={StaticResource BoolVisibility}}" />
  </StackPanel>
 </StackPanel>
</UserControl>
