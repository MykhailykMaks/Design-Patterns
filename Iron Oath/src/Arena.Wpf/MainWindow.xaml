<Window x:Class="Arena.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Arena.Wpf.Views"
 Title="Iron Oath" WindowStyle="None" WindowState="Maximized" PreviewKeyDown="HandleWindowKey" Width="1390" Height="970" MinWidth="900" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#10171D" FontFamily="Inter, Segoe UI" UseLayoutRounding="True">
 <Grid SizeChanged="FitScene"><Viewbox x:Name="Viewport" Stretch="Uniform">
  <Grid x:Name="Scene" Width="1360" Height="900" ClipToBounds="True">
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1F2B34" /><GradientStop Color="#111A21" Offset="0.6" /><GradientStop Color="#252B2C" Offset="1" /></LinearGradientBrush></Grid.Background>
   <views:ArenaBackdrop />
   <Border Margin="18" BorderThickness="1" BorderBrush="#54605E" CornerRadius="3" IsHitTestVisible="False" />
   <Grid Margin="54,32">
    <views:MenuView><views:MenuView.Style><Style BasedOn="{StaticResource ScreenEntrance}" TargetType="views:MenuView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Menu"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:MenuView.Style></views:MenuView>
    <views:SettingsView><views:SettingsView.Style><Style BasedOn="{StaticResource ScreenEntrance}" TargetType="views:SettingsView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:SettingsView.Style></views:SettingsView>
    <Grid Margin="68,0">
     <views:TeamView><views:TeamView.Style><Style BasedOn="{StaticResource ScreenEntrance}" TargetType="views:TeamView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Team"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:TeamView.Style></views:TeamView>
     <views:BattleView><views:BattleView.Style><Style BasedOn="{StaticResource ScreenEntrance}" TargetType="views:BattleView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Battle"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:BattleView.Style></views:BattleView>
     <views:BattleResultView Margin="0,24">
      <views:BattleResultView.Style>
       <Style TargetType="views:BattleResultView">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="Result"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
       </Style>
      </views:BattleResultView.Style>
     </views:BattleResultView>
    </Grid>
   </Grid>
   <Border VerticalAlignment="Bottom" Background="#F03D2924" Padding="12,7" Margin="70,0,70,26">
    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F8D2AA" FontSize="14" />
   </Border>
  </Grid>
 </Viewbox></Grid>
</Window>
